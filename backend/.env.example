HOST=127.0.0.1
PORT=5000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/animation_pipeline
PGHOST=127.0.0.1
PGPORT=5434
PGUSER=postgres
PGDATABASE=animation_pipeline
MEDIA_DIR=./media
# Optional absolute path when the repository is run from a non-standard layout.
# PROJECT_ROOT=/absolute/path/to/Animation-bittrix
KOKORO_MODEL=onnx-community/Kokoro-82M-v1.0-ONNX
KOKORO_VOICE=af_sarah
KOKORO_SPEED=1
# Codex per-attempt exec budget; 300000 = 5 minutes. Allowed range: 2-10 minutes.
CODEX_TIMEOUT_MS=300000
# Total budget shared by the initial plan, one retry/recovery, and validation repairs.
CODEX_TOTAL_TIMEOUT_MS=480000
# One bounded retry is used after a Codex response timeout; allowed range: 3-5 minutes.
CODEX_RETRY_TIMEOUT_MS=180000
# Fast creative-only requests (for example, "make a 3D apple move to a basket")
# do not browse and use these shorter bounded budgets.
CODEX_CREATIVE_TIMEOUT_MS=90000
CODEX_CREATIVE_TOTAL_TIMEOUT_MS=180000
CODEX_CREATIVE_RETRY_TIMEOUT_MS=60000
# ── Whisper (optional) ─────────────────────────────────────────────────────
# Install: pip3 install openai-whisper --break-system-packages
# Then download the base model once: python3 -c "import whisper; whisper.load_model('base')"
# Set DISABLE_WHISPER=1 to force character-weighted caption fallback even if whisper is installed.
WHISPER_BIN=whisper
WHISPER_MODEL=base
# DISABLE_WHISPER=1
# ── Asset Fetcher ───────────────────────────────────────────────────────────
# Timeout (ms) per HTTP request to Wikimedia/Openverse; default 12000.
# ASSET_FETCH_TIMEOUT_MS=12000
