{
  "name": "ai-animation-pipeline",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend ci && npm --prefix frontend ci && npm --prefix remotion ci && npm run motion:setup",
    "motion:setup": "node scripts/setup-motion-checks.mjs",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:status": "node scripts/db.mjs status",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "remotion:typecheck": "npm --prefix remotion run typecheck",
    "qa:scene-stills": "node scripts/render-scene-stills.mjs",
    "build": "npm run backend:build && npm run frontend:build && npm run remotion:typecheck"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
